# Absolute host path. Dynamic build/runtime containers must see this exact path.
DATA_HOST_ROOT=/home/ritsdev/create-data
# Numeric owner used by the rootless platform/gateway containers. Set these
# to the deployment account's `id -u` and `id -g`.
PLATFORM_UID=1000
PLATFORM_GID=1000

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-long-random

RUSTFS_ACCESS_KEY=ritsdevadmin
RUSTFS_SECRET_KEY=change-me-long-random

PLATFORM_SESSION_SECRET=change-me-64-random-hex
SECRET_ENCRYPTION_KEY=change-me-different-64-random-hex
EDGE_PROXY_SECRET=change-me-third-independent-64-random-hex

# Generate these files once and keep them outside the repository:
# openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out oauth-private.pem
# openssl rsa -pubout -in oauth-private.pem -out oauth-public.pem
OAUTH_PRIVATE_KEY_HOST_FILE=/home/ritsdev/create-secrets/oauth-private.pem
OAUTH_PUBLIC_KEY_HOST_FILE=/home/ritsdev/create-secrets/oauth-public.pem

GOOGLE_CLIENT_ID=replace.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace

# Comma-separated email domains allowed to sign in, e.g. example.edu. One of
# this and AUTH_ALLOW_ANY_GOOGLE_DOMAIN must be set: an unset gate would admit
# nobody or everybody depending on how it failed, so the platform refuses to
# start until the deployment has said which it wants.
#
# With exactly one domain the Google account chooser is pre-filtered to it
# (`hd`). With several the hint cannot be sent — it is single-valued — and the
# list is enforced on the verified token instead, which is where the real check
# has always been.
AUTH_ALLOWED_EMAIL_DOMAINS=example.edu
# Set to 1 to accept any verified Google account. An open installation is a
# deliberate choice, not a default: see the rate limits before making it.
AUTH_ALLOW_ANY_GOOGLE_DOMAIN=

# Comma-separated brand names a phishing page hosted here would wear: your
# organisation's name, and what it calls its accounts. These are ADDED to a
# built-in list of brands every installation shares (google, microsoft,
# outlook, duo, single sign-on...), so leaving them empty costs you local
# coverage but never disables the review.
SITE_REVIEW_IMPERSONATION_TERMS=example university,exampleid
# Words that signal a page is asking for a credential, again added to the
# built-in list (password, passcode, username, sign in, login...).
SITE_REVIEW_CREDENTIAL_TERMS=exampleid

# The highest visibility an ordinary account may give a project: owner, network,
# or showcase. Leave it at showcase for a private-network installation. Set it
# to `owner` if you open sign-ups to anyone — projects stay visible to their own
# owner and the gallery empties, while operator accounts keep the full ladder so
# you can still publish examples yourself.
MAX_ACCESS_MODE=showcase

# Comma-separated accounts that may open the read-only system admin view at
# /admin. The list is declarative: on every start the listed accounts are
# granted the operator role and any other operator is demoted. Leave it empty
# to manage `accounts.platform_role` directly in the control database instead.
PLATFORM_OPERATOR_EMAILS=
# Comma-separated accounts that may WRITE through /v1/admin: every account's
# project quota and role, and every project's resource limits. Superadmins are
# granted here and nowhere else — the API refuses to mint or demote one — so
# this line is the whole answer to "who can change other people's accounts".
# Setting it does not demote operators granted through the API; setting
# PLATFORM_OPERATOR_EMAILS does.
PLATFORM_SUPERADMIN_EMAILS=
# The project quota an operator account creates against, when its own
# accounts.project_quota column is lower. Never written to a row.
OPERATOR_PROJECT_QUOTA=25

CLOUDFLARE_API_TOKEN=replace
CLOUDFLARE_TUNNEL_TOKEN=replace
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.7.2@sha256:4f6655284ab3d252b7f28fedb19fe6c8fc82ee5b1295c20ac74d475e5398a52d

# The domain this installation answers on. Required: there is no default, so
# that a half-configured stack refuses to start rather than quietly serving
# links and mail headers that name a different installation. Project sites are
# labels beneath it, so DNS needs both this name and `*.` under it.
GATEWAY_DOMAIN=sites.example.org
# Only when the public origin differs from the domain above — behind a proxy on
# another name, say. Left empty it is derived as https://$GATEWAY_DOMAIN.
PUBLIC_BASE_URL=
# The IANA zone your visitors are in. Analytics buckets a day by this, so
# getting it wrong shifts every day's traffic onto the neighbouring bar. There
# is no default on purpose; see deploy/platform/src/lib/analytics.ts.
ANALYTICS_TIMEZONE=UTC
# The address Let's Encrypt contacts about this installation's certificates.
ACME_EMAIL=admin@sites.example.org

# Bind wildcard application TLS only to this LAN/VPN address. NETWORK_CIDRS is
# enforced again by the gateway after Caddy authenticates the proxy hop.
LAN_BIND_IP=10.0.0.10
NETWORK_CIDRS=10.0.0.0/8

# Docker networks use explicit pools so the platform does not depend on
# Docker's finite automatic address pool. Override these only when they overlap
# a host, LAN, VPN, or existing Docker route.
DATA_CONTROL_SUBNET=192.168.64.0/28
STORAGE_CONTROL_SUBNET=192.168.64.16/28
ROOT_EDGE_SUBNET=192.168.64.32/28
SITE_EDGE_SUBNET=192.168.64.48/28
RENDER_SUBNET=192.168.64.64/28
PUBLIC_CONTROL_SUBNET=192.168.64.80/28
CERTIFICATE_EGRESS_SUBNET=192.168.64.96/28
BUILD_EGRESS_SUBNET=192.168.64.112/28
RUNTIME_NETWORK_POOL=192.168.68.0/22
BUILD_NETWORK_POOL=192.168.72.0/24
DYNAMIC_NETWORK_PREFIX=28

# The control plane derives its trusted reverse-proxy ranges from
# ROOT_EDGE_SUBNET and PUBLIC_CONTROL_SUBNET. Only the Cloudflare tunnel
# subnet may assert CF-Connecting-IP; direct clients cannot opt into trust by
# supplying forwarding headers.

# Runtime/build images are pinned. Update them only through a conformance run.
NODE_BUILD_IMAGE=node:24-alpine@sha256:a0b9bf06e4e6193cf7a0f58816cc935ff8c2a908f81e6f1a95432d679c54fbfd
DENO_RUNTIME_IMAGE=denoland/deno:2.9.4@sha256:c777b4b225501a61074837e90a826a58f99124837824023cd60334b1e2374498
# Built locally from deploy/render, which pins the upstream Playwright digest.
# The upstream image ships the browsers but not the playwright npm package the
# renderer requires, so it cannot be used directly.
PLAYWRIGHT_IMAGE=ritsdev-render:local

# --- Monitoring -------------------------------------------------------------
# Metrics are served on their own listener, on a port no ingress publishes.
# That separation, not any Caddy rule, is what keeps them off the public
# tunnel: cloudflared reaches platform:3000 directly and never passes through
# Caddy. The token below is defence in depth on top of it.
METRICS_PORT=9090
METRICS_TOKEN=
# Optional peer allowlist for the metrics listener, comma separated. Empty
# means the token is the only gate, which is sufficient while the port is
# unpublished and only reachable from the platform's own networks.
METRICS_ALLOWED_CIDRS=
# Set to 1 only if you deliberately want an unauthenticated private listener.
ALLOW_UNAUTHENTICATED_METRICS=
# Per-project metric labels. Fine at this project count; turn off if it grows.
METRICS_PER_PROJECT=1

# --- Executor concurrency ---------------------------------------------------
# Two cores: one heavy job (build, render, export) at a time is the real limit,
# with a second worker for deploys and cold starts meanwhile.
EXECUTOR_CONCURRENCY=1
EXECUTOR_HEAVY_CONCURRENCY=1
# Lease is renewed while a job genuinely runs; the per-kind maximum runtime in
# lib/job-claim.ts is what eventually stops the renewal.
EXECUTOR_LEASE_SECONDS=120
EXECUTOR_SHUTDOWN_GRACE_MS=30000

# --- Alerting ---------------------------------------------------------------
# Alerts are mailed through the smtp-relay container on the mail-control
# network, so the SMTP hop never leaves this host. That is why plaintext is
# acceptable and is opted into explicitly.
SMTP_HOST=smtp-relay
SMTP_PORT=25
SMTP_TLS=none
SMTP_ALLOW_PLAINTEXT=1
# This host's fully qualified name. OpenSMTPD announces it in HELO, and it must
# match the forward and reverse DNS of the address this host sends from — run
# `hostname -f` and check `dig -x <address>` agrees.
MAIL_HELO_NAME=host.example.org
# Send as the host FQDN rather than GATEWAY_DOMAIN, unless that domain publishes
# SPF and MX of its own: mail claiming to come from a domain with neither is
# unauthenticated and liable to be junked even when the receiving MTA accepts
# it. The host FQDN has matching forward and reverse DNS.
ALERT_FROM=create-platform@host.example.org
# Optional: the platform's own HELO. Defaults to MAIL_HELO_NAME above, which is
# what the relay announces downstream, so set this only if they must differ.
SMTP_HELO_NAME=

# How alerts are sent: "smtp" or "cloudflare". Leave empty and whichever is
# configured is used, preferring cloudflare.
#
# Most cloud providers block outbound port 25 by default and lift it only by
# support ticket, which makes the SMTP relay above unusable on a rented VPS.
# Cloudflare Email Sending goes out over HTTPS instead and needs no open port.
# It has no SMTP endpoint, so the two are genuinely different transports rather
# than two ways of reaching the same one.
#
# The token needs Cloudflare's email sending permission, and the domain in
# ALERT_FROM must be onboarded to Email Sending first:
#   npx wrangler email sending enable example.org
MAIL_TRANSPORT=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_TOKEN=
# Where alerts go. Check first that outbound port 25 from this host actually
# reaches the recipient's MX — many networks block it selectively, and a
# blocked route fails silently rather than bouncing.
ALERT_TO=
ALERT_RENOTIFY_MINUTES=360
# Optional JSON overriding individual rule thresholds; validated at startup.
ALERT_THRESHOLDS=

# --- Backups ----------------------------------------------------------------
# Destination for the nightly off-host backup. Must be a machine that is not
# this one; the whole point is surviving the loss of it. Three forms:
#   rsync://user@nas/backups/create   the rsync daemon — Synology exposes this
#                                     as "Network Backup" and it needs no shell
#   user@host:/path                   rsync over SSH
#   /mnt/nas/create-backups           a local path, i.e. an SMB or NFS mount
BACKUP_DEST=
# For the rsync daemon: a file containing only the module password. Kept out of
# this file so the credential does not sit beside the data it protects.
BACKUP_RSYNC_PASSWORD_FILE=
# For a mounted destination: refuse to run if it is not actually mounted, so a
# silently failed mount cannot write every backup onto this host instead.
BACKUP_REQUIRE_MOUNT=1
# Public key id or email that backups are encrypted to. Leave blank only if the
# destination is as trusted as this host. The matching PRIVATE key must never
# be on this machine, and must be stored somewhere you can still reach after
# losing it — without it, every backup is permanently unreadable.
BACKUP_GPG_RECIPIENT=
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_STAGING=/var/tmp/ritsdev-backup
# Managed LLM binding (optional). Without LLM_ADMIN_KEY the platform still
# starts and a project asking for resources.llm gets 503.
#
# Point these at your own OpenAI-compatible proxy. LiteLLM is what this was
# built against; the key is one of its admin/virtual keys. There is no default
# URL on purpose: a key set without a URL would otherwise send your admin
# credential and every project's name to whatever host the default named.
#
# Set the key on the platform service only. The executor holds the Docker
# socket and never needs it, and runtimes reach the proxy directly over 443.
LLM_ADMIN_KEY=
LLM_ADMIN_URL=https://llm.example.org
LLM_BASE_URL=https://llm.example.org/v1
LLM_MODEL=your-model-name
# Optional, comma-separated: every model a minted key is allowed to call. Leave
# it empty and a key may call LLM_MODEL alone, which is what every key issued
# before this variable existed carries. LLM_MODEL stays the one the platform
# sends and the one runtimes are told to use, and is always allowed whether or
# not it is repeated here. Widening this changes nothing for a key that already
# exists: the allowlist is stamped on at issuance, so an existing project picks
# it up only when its key is next minted.
LLM_MODELS=
# Keys are issued with a fixed TTL; the platform runs no renewal scheduler.
LLM_KEY_DURATION=90d
# Optional LiteLLM team, so the proxy can also cap every project key in
# aggregate rather than only per project.
LLM_TEAM_ID=
