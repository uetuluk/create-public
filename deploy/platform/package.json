{
  "name": "@create-ritsdev/platform",
  "private": true,
  "version": "0.0.1",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --enable-source-maps dist/server.js",
    "build": "tsc -p tsconfig.json --noEmit && esbuild src/server.ts src/gateway.ts src/executor.ts src/build-proxy.ts --bundle --outdir=dist --platform=node --format=esm --packages=external --sourcemap",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-reporter=spec 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "bcryptjs": "^3.0.0",
    "hono": "^4.12.32",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.22.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
